{
  "name": "@cyanheads/cisa-cybersecurity-mcp-server",
  "version": "0.1.0",
  "mcpName": "io.github.cyanheads/cisa-cybersecurity-mcp-server",
  "description": "CISA Known Exploited Vulnerabilities with BOD 26-04 deadlines, SSVC prioritization, and the full ICS advisory corpus (CSAF) via MCP. Keyless. STDIO & Streamable HTTP.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "cisa-cybersecurity-mcp-server": "dist/index.js"
  },
  "files": [
    "changelog/",
    "dist/",
    "scripts/_mirror-context.ts",
    "scripts/csaf-mirror-init.ts",
    "scripts/csaf-mirror-refresh.ts",
    "scripts/csaf-mirror-verify.ts",
    "README.md",
    "LICENSE",
    "CLAUDE.md",
    "AGENTS.md",
    "Dockerfile",
    "server.json"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "rebuild": "bun run scripts/clean.ts && bun run scripts/build.ts",
    "clean": "bun run scripts/clean.ts",
    "devcheck": "bun run scripts/devcheck.ts",
    "audit:fix": "bun audit fix",
    "audit:refresh": "rm -f bun.lock && bun install && bun audit",
    "tree": "bun run scripts/tree.ts",
    "list-skills": "bun run scripts/list-skills.ts",
    "format": "biome check --write .",
    "format:unsafe": "biome check --write --unsafe .",
    "lint:mcp": "bun run scripts/lint-mcp.ts",
    "lint:packaging": "bun run scripts/lint-packaging.ts",
    "mirror:init": "bun run scripts/csaf-mirror-init.ts",
    "mirror:refresh": "bun run scripts/csaf-mirror-refresh.ts",
    "mirror:verify": "bun run scripts/csaf-mirror-verify.ts",
    "bundle": "bun run build && npx -y @anthropic-ai/mcpb pack . dist/cisa-cybersecurity-mcp-server.mcpb && bun run scripts/clean-mcpb.ts dist/cisa-cybersecurity-mcp-server.mcpb",
    "changelog:build": "bun run scripts/build-changelog.ts",
    "changelog:check": "bun run scripts/build-changelog.ts --check",
    "release:github": "bun run scripts/release-github.ts",
    "publish-mcp": "mcp-publisher login github -token \"$(security find-generic-password -a \"$USER\" -s mcp-publisher-github-pat -w)\" && mcp-publisher publish",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "start": "node dist/index.js",
    "start:stdio": "MCP_TRANSPORT_TYPE=stdio node dist/index.js",
    "start:http": "MCP_TRANSPORT_TYPE=http node dist/index.js"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "typescript",
    "bun",
    "stdio",
    "streamable-http",
    "cisa",
    "kev",
    "known-exploited-vulnerabilities",
    "bod-26-04",
    "ssvc",
    "csaf",
    "ics-advisories",
    "ics-security",
    "vulnerability",
    "vulnerability-management",
    "security",
    "cve",
    "ai-agents",
    "ai-tools",
    "cyanheads"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyanheads/cisa-cybersecurity-mcp-server.git"
  },
  "license": "Apache-2.0",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@cyanheads/mcp-ts-core": "^0.13.6",
    "better-sqlite3": "^13.0.3",
    "fast-xml-parser": "^5.11.1",
    "node-cron": "^4.6.0",
    "pino-pretty": "^13.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@socketsecurity/bun-security-scanner": "^1.1.2",
    "@types/node": "26.6.1",
    "@vitest/coverage-istanbul": "5.0.1",
    "depcheck": "^1.4.7",
    "fast-check": "^4.10.1",
    "ignore": "^7.0.9",
    "tsc-alias": "^1.9.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "author": "Casey Hand <casey@caseyjhand.com> (https://caseyjhand.com)",
  "homepage": "https://github.com/cyanheads/cisa-cybersecurity-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/cyanheads/cisa-cybersecurity-mcp-server/issues"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/cyanheads"
    },
    {
      "type": "buy_me_a_coffee",
      "url": "https://www.buymeacoffee.com/cyanheads"
    }
  ]
}
