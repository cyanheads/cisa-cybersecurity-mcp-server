.env*
.mcpregistry_*
/.claude/
/.agents/
/framework-skills/
/Dockerfile
/bun.lock
/bunfig.toml
/wrangler.toml
/biome.json
/tsconfig*.json
/vitest.config.ts

# An advisory index a checkout may hold here — written by an older build's
# working-directory default, or by CISA_CSAF_MIRROR_PATH pointed at it. It grows
# to the size of the corpus, is stale the moment it is packed, and a bundle seeds
# its own in the user's cache directory on first run — so it must never travel
# inside one.
/.mirror/

# Build and machine leftovers: the incremental build map and .DS_Store both
# carry absolute local paths and directory listings, and a previously packed
# bundle sits in the same output directory as the one being packed.
*.tsbuildinfo
.DS_Store
*.mcpb
/coverage/
